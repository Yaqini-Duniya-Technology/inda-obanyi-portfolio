{
  "rewrites": [
    {
      "source": "/projects/fraudguard-ai",
      "destination": "/projects/fraudguard-ai/index.html"
    },
    {
      "source": "/projects/smart-farmai",
      "destination": "/projects/smart-farmai/index.html"
    },
    {
      "source": "/projects/resume-screening",
      "destination": "/projects/resume-screening/index.html"
    },
    {
      "source": "/projects/airline-satisfaction",
      "destination": "/projects/airline-satisfaction/index.html"
    },
    {
      "source": "/projects/floodguard-ai",
      "destination": "/projects/floodguard-ai/index.html"
    },
    {
      "source": "/projects/indaverse",
      "destination": "/projects/indaverse/index.html"
    },
    {
      "source": "/projects/teachers-handbook",
      "destination": "/projects/teachers-handbook/index.html"
    },
    {
      "source": "/projects/yaqini-duniya-technology",
      "destination": "/projects/yaqini-duniya-technology/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
